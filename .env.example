# Copy to .env.local for local work. On Netlify, add these under Site configuration > Environment variables.

# Public address of the site, used for Stripe return links
NEXT_PUBLIC_SITE_URL=https://golfme.com.au

# Stripe (use test keys first: they start with sk_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
